<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Styled Landing Page with Image Gallery</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="horizontal-menu">
            <ul>
                <li><a href="#home"><i class="fas fa-home"></i> Home</a></li>
                <li><a href="#gallery"><i class="fas fa-images"></i> Gallery</a></li>
                <li><a href="#contact"><i class="fas fa-envelope"></i> Contact</a></li>
            </ul>
        </nav>
    </header>

    <section id="home" class="section">
        <h1>Welcome to Our Landing Page</h1>
        <p>Enjoy our beautiful image gallery with smooth transitions and effects.</p>
    </section>

    <section id="gallery" class="section">
        <h2>Image Gallery</h2>
        <div class="gallery">
            <img src="https://via.placeholder.com/200" alt="Sample 1">
            <img src="https://via.placeholder.com/200" alt="Sample 2">
            <img src="https://via.placeholder.com/200" alt="Sample 3">
            <img src="https://via.placeholder.com/200" alt="Sample 4">
        </div>
    </section>

    <section id="contact" class="section">
        <h2>Contact Us</h2>
        <p>Email: contact@example.com</p>
    </section>

    <nav class="vertical-menu">
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#gallery">Gallery</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</body>
</html>
